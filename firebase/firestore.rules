rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'; }
    match /admins/{uid} { allow get: if signedIn() && (request.auth.uid == uid || admin()); allow list: if admin(); allow write: if false; }

    // Program/session definitions must be published only by the KTH administrator.
    match /programs/{programId} { allow read: if signedIn(); allow write: if admin(); }
    match /organizations/{orgId} { allow read, write: if admin(); }
    match /sessions/{sessionId} { allow read: if signedIn(); allow write: if admin(); }

    // Identity stays private. A learner may create their own minimal profile.
    match /participants/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email','jobTitle','department','experience','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.jobTitle is string
        && request.resource.data.jobTitle.size() <= 100
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 100
        && request.resource.data.experience in ['0-2','3-5','6-10','11+'];
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if admin();
    }

    // Enrollments are created by the administrator or a trusted server function,
    // not by a public invitation URL alone.
    match /enrollments/{enrollmentId} {
      allow get, list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if admin();
    }

    // Assessment events are append-only. The authenticated learner may submit
    // a response only for a server-issued enrollment belonging to their account.
    // Final scores/skill judgments should be computed on the server.
    match /assessmentResponses/{responseId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','enrollmentId','programId','sessionId','assessmentId','questionId','selectedOption','createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.selectedOption is int
        && request.resource.data.selectedOption >= 0
        && request.resource.data.selectedOption <= 2
        && request.resource.data.sessionId == 'KH-SS-001'
        && request.resource.data.enrollmentId == 'KH-SS-001_' + request.auth.uid
        && request.resource.data.programId == 'selling-skills'
        && request.resource.data.assessmentId == 'prework-v1'
        && request.resource.data.questionId in ['q0','q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11']
        && responseId == request.resource.data.enrollmentId + '_' + request.resource.data.questionId;
      allow get, list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // User-owned learning snapshots. Browser-generated scores are not certified skill assessments.
    match /learningStates/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','sessionId','state','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.sessionId == 'KH-SS-001'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.state is map;
      allow delete: if admin();
    }

    // Server-managed computed scores and admin reporting only.
    match /assessmentResults/{resultId} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if admin(); }
    match /skillEvaluations/{evaluationId} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if admin(); }
    match /adminReports/{reportId} { allow read, write: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
