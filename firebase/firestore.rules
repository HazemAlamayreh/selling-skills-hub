rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.kthAdmin == true; }

    // Program/session definitions must be published only by the KTH administrator.
    match /programs/{programId} { allow read: if signedIn(); allow write: if admin(); }
    match /organizations/{orgId} { allow read, write: if admin(); }
    match /sessions/{sessionId} { allow read: if signedIn(); allow write: if admin(); }

    // Identity stays private. A learner may create their own minimal profile.
    match /participants/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if admin();
    }

    // Enrollments are created by the administrator or a trusted server function,
    // not by a public invitation URL alone.
    match /enrollments/{enrollmentId} {
      allow get, list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    // Assessment events are append-only. The authenticated learner may submit
    // a response only for a server-issued enrollment belonging to their account.
    // Final scores/skill judgments should be computed on the server.
    match /assessmentResponses/{responseId} {
      function ownEnrollment() {
        return exists(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId))
          && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.uid == request.auth.uid;
      }
      allow create: if signedIn() && ownEnrollment()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','enrollmentId','programId','sessionId','assessmentId','questionId','selectedOption','createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.selectedOption is int
        && request.resource.data.selectedOption >= 0
        && request.resource.data.selectedOption <= 9;
      allow get, list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // Server-managed computed scores and admin reporting only.
    match /assessmentResults/{resultId} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if admin(); }
    match /skillEvaluations/{evaluationId} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if admin(); }
    match /adminReports/{reportId} { allow read, write: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
